# StakTrakr Home Poller — environment variables
# Copy to .env and fill in values. Never commit .env.

# Primary database — choose ONE option below.
#
# Option A (default): local self-hosted sqld
SQLD_URL=http://staktrakr-sqld:8080
SQLD_AUTH_TOKEN=

# Option B: Turso Cloud as primary (self-hosters without a sqld container).
# Code reads TURSO_DATABASE_URL / TURSO_AUTH_TOKEN only if SQLD_URL is unset.
#TURSO_DATABASE_URL=libsql://your-db.turso.io
#TURSO_AUTH_TOKEN=your-turso-auth-token

# Nightly DR backup to Turso Cloud (turso-backup-sync.js) — independent of
# primary DB choice. Unset to disable nightly DR.
TURSO_BACKUP_URL=libsql://staktrakrapi-lbruton.aws-us-east-2.turso.io
TURSO_BACKUP_TOKEN=your-turso-backup-token

# Poller identity — written to price_snapshots.source for tracing
POLLER_ID=home

# Path to providers.json parent — expects data/retail/providers.json inside
DATA_DIR=/opt/poller/data

# Optional: restrict to specific coins for testing
# COINS=ase,age

# Optional: dry run (no DB writes)
# DRY_RUN=1
