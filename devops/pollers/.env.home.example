# StakTrakr Home Poller — Environment Variables
# Copy to .env.home and fill in values before deploying.

# Primary database — choose ONE of the two options below.
#
# Option A (default, what lbruton/StakTrakr runs): local self-hosted sqld
#   - Docker (home-poller):       http://staktrakr-sqld:8080
#   - Fly.io (via Tailscale):     http://192.168.1.81:8080
SQLD_AUTH_TOKEN=
SQLD_URL=http://staktrakr-sqld:8080

# Option B (self-hosters without a sqld container): Turso Cloud as primary.
# Code reads TURSO_DATABASE_URL / TURSO_AUTH_TOKEN only if SQLD_URL is unset.
# Leave these UNSET in deployment when using Option A.
#TURSO_DATABASE_URL=libsql://your-db.turso.io
#TURSO_AUTH_TOKEN=your-turso-auth-token

# Nightly DR backup to Turso Cloud (turso-backup-sync.js) — independent of
# primary DB choice. Unset to disable nightly DR.
TURSO_BACKUP_URL=libsql://staktrakrapi-lbruton.aws-us-east-2.turso.io
TURSO_BACKUP_TOKEN=your-turso-backup-token

# Spot price API
METAL_PRICE_API_KEY=your-key

# Firecrawl (Docker service on staktrakr-net — leave empty to use direct Playwright)
FIRECRAWL_BASE_URL=http://firecrawl-api:3002

# Vision pipeline (optional — set to 1 to enable)
VISION_ENABLED=0
GEMINI_API_KEY=

# MintBuilder direct price feed (STRK-321, optional — unset falls back to page
# scraping). First-party vendor API key; keep it out of provider URLs and any
# published JSON. Must also stay declared in docker-compose.home.yml.
MB_API_KEY=

# Fly.io health check
FLYIO_TAILSCALE_IP=100.90.171.110
FLYIO_HTTP_URL=https://api2.staktrakr.com/data/retail/providers.json

# Byparr sidecar (Cloudflare bypass for 403 vendors — Camoufox-based)
CF_CLEARANCE_SCRAPER_URL=http://byparr:8191  # Internal URL of the Byparr sidecar — no change needed when running on staktrakr-net
CF_CLEARANCE_ENABLED=1                                      # Set to 0 to disable CF fallback entirely (all 403s remain terminal)
CF_CLEARANCE_TIMEOUT_MS=30000                               # Max ms to wait for the sidecar to solve a CF challenge
