# StakTrakr Home Poller — Environment Variables
# Copy to .env.home and fill in values before deploying.

# Local sqld database (self-hosted libSQL) — primary DB for all pollers
# For Docker (home-poller): http://staktrakr-sqld:8080
# For Fly.io (remote-poller via Tailscale): http://192.168.1.81:8080
SQLD_URL=http://staktrakr-sqld:8080
SQLD_AUTH_TOKEN=your-token

# Legacy names — still read as fallback during STAK-548 rollout; can be removed
# once all Portainer stacks have been redeployed with SQLD_URL.
TURSO_DATABASE_URL=http://staktrakr-sqld:8080
TURSO_AUTH_TOKEN=your-token

# Nightly DR sync to Turso Cloud free tier (turso-backup-sync.js)
TURSO_BACKUP_URL=libsql://staktrakrapi-lbruton.aws-us-east-2.turso.io
TURSO_BACKUP_TOKEN=your-turso-backup-token

# Spot price API
METAL_PRICE_API_KEY=your-key

# Firecrawl (Docker service on staktrakr-net — leave empty to use direct Playwright)
FIRECRAWL_BASE_URL=http://firecrawl-api:3002

# Vision pipeline (optional — set to 1 to enable)
VISION_ENABLED=0
GEMINI_API_KEY=

# Fly.io health check
FLYIO_TAILSCALE_IP=100.90.171.110
FLYIO_HTTP_URL=https://api2.staktrakr.com/data/retail/providers.json

# Byparr sidecar (Cloudflare bypass for 403 vendors — Camoufox-based)
CF_CLEARANCE_SCRAPER_URL=http://byparr:8191  # Internal URL of the Byparr sidecar — no change needed when running on staktrakr-net
CF_CLEARANCE_ENABLED=1                                      # Set to 0 to disable CF fallback entirely (all 403s remain terminal)
CF_CLEARANCE_TIMEOUT_MS=30000                               # Max ms to wait for the sidecar to solve a CF challenge
