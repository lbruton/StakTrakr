# macOS
.DS_Store
.AppleDouble
.LSOverride

# Node modules (if added in future)
node_modules/
npm-debug.log*

# Editor directories and files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# OS
Thumbs.db
Desktop.ini

# Logs
*.log
logs/

# Environment variables
.env
.env.local

# Python
__pycache__/
*.pyc

# DevOps tooling — hooks and protocol docs tracked; build artifacts and secrets excluded
devops/**/.env
devops/screenshots/
devops/node_modules/
devops/docs/
devops/claude-backup/
devops/firecrawl-docker/

# Version lock — main-checkout-only mutex for version claims.
# Must NOT follow worktrees: copies would conflict every bump and break the claim.
devops/version.lock

# Webscale wspc cookie store (STRK-230) — holds live bot-clearance cookies.
# Never commit. On the home poller WEBSCALE_COOKIE_FILE points outside the repo;
# this guard catches the module-local default too.
webscale-cookies.json

# Playwright test artifacts
test-results/
playwright-report/

# AI/MCP configuration files are tracked for project consistency
.firecrawl/
.antigravitycli/

# Git worktrees for isolated agent work — content dirs are transient, not project history
.worktrees/
.claude/worktrees/

# Claude read tracker — session-scoped UUID-named read history, not project history
claude-read-tracker/

# Specflow transient run state — only config.json is tracked.
.specflow/**
!.specflow/config.json

# Local agent overrides — *.local.* files are per-machine, never shared
# (e.g. settings.local.json, hookify *.local.md). Shared config has no .local. infix.
.claude/**/*.local.*

# MCP config — per-user server commands/env may carry credentials
# (Plane/GitHub/Infisical tokens); never tracked. .playwright-mcp/ is a transient
# browser-session dir, not project history.
.mcp.json
.playwright-mcp/
