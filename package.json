{
  "name": "staktrakr",
  "private": true,
  "version": "3.36.67",
  "license": "MIT",
  "type": "module",
  "description": "Precious metals inventory tracker",
  "scripts": {
    "lint": "eslint .",
    "test:unit": "node devops/testing/run-unit.mjs",
    "build:collections": "node devops/collections/build-collections-bundle.mjs",
    "lint:md": "bash devops/hooks/lint-markdown-changed.sh --staged",
    "lint:md:changed": "bash devops/hooks/lint-markdown-changed.sh --changed",
    "lint:md:all": "npx --yes markdownlint-cli --config .markdownlint.json --ignore-path .markdownlintignore \"**/*.md\" \".context/**/*.md\" \".agents/**/*.md\" \".claude/**/*.md\"",
    "test": "npm run test:core",
    "test:core": "npx playwright test tests/playwright/core",
    "test:coverage": "COVERAGE=1 npx playwright test tests/playwright/core && node devops/testing/coverage-merge.mjs --no-map",
    "test:map": "COVERAGE=1 npx playwright test tests/playwright/core && node devops/testing/coverage-merge.mjs",
    "test:changed": "node devops/testing/test-changed.mjs",
    "test:redundancy": "node devops/testing/test-redundancy.mjs",
    "test:extended": "npx playwright test tests/playwright/extended --pass-with-no-tests",
    "test:all": "npm run test:unit && npm run test:core && npm run test:extended",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{js,css,html,json,md}": "prettier --write",
    "*.{js,mjs,cjs}": "eslint --no-warn-ignored"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "acorn": "^8.19.0",
    "eslint": "^9.39.5",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^14.0.0",
    "lint-staged": "^17.6.0",
    "monocart-coverage-reports": "^3.0.0",
    "prettier": "^3.9.10"
  }
}
