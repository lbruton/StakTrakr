{
  "name": "staktrakr",
  "private": true,
  "version": "3.34.87",
  "license": "MIT",
  "type": "module",
  "description": "Precious metals inventory tracker",
  "scripts": {
    "lint": "eslint js/*.js sw.js sw-router.js \"tests/unit/**/*.js\"",
    "test:unit": "node --test tests/unit/sw-router.test.js",
    "lint:md": "bash devops/hooks/lint-markdown-changed.sh --staged",
    "lint:md:changed": "bash devops/hooks/lint-markdown-changed.sh --changed",
    "lint:md:all": "npx --yes markdownlint-cli --config .markdownlint.json --ignore-path .markdownlintignore \"**/*.md\"",
    "test": "npx playwright test",
    "test:offline": "npx playwright test --grep-invert @network",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{js,css,html,json,md}": "prettier --write"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "eslint": "^9.21.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3"
  }
}
